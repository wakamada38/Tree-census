function ringSVG(pct, size=44){
  const stroke = 5;
  const r = (size - stroke)/2;
  const c = 2*Math.PI*r;
  const offset = c - (pct/100)*c;
  let color = '#2D6A4F';
  if(pct < 40) color = '#A8442A';
  else if(pct < 70) color = '#C9A227';
  return `<svg width="${size}" height="${size}">
    <circle cx="${size/2}" cy="${size/2}" r="${r}" stroke="#E1E7DE" stroke-width="${stroke}" fill="none"/>
    <circle cx="${size/2}" cy="${size/2}" r="${r}" stroke="${color}" stroke-width="${stroke}" fill="none"
      stroke-dasharray="${c}" stroke-dashoffset="${offset}" stroke-linecap="round"/>
  </svg>`;
}

function fmtDate(d){
  if(!d) return '—';
  const dt = new Date(d + 'T00:00:00');
  if(isNaN(dt)) return d;
  return dt.toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'});
}

function renderStats(){
  let planted = 0, surviving = 0;
  const varieties = new Set();
  entries.forEach(e=>{
    const latest = latestCensus(e);
    planted += Number(latest.planted)||0;
    surviving += Number(latest.surviving)||0;
    const speciesKey = (e.name||'').trim().toLowerCase();
    if(speciesKey) varieties.add(speciesKey);
  });
  const rate = planted ? Math.round((surviving/planted)*100) : 0;
  document.getElementById('statPlanted').textContent = planted;
  document.getElementById('statSurviving').textContent = surviving;
  document.getElementById('statRate').textContent = rate + '%';
  document.getElementById('statVarieties').textContent = varieties.size;
}

function renderList(){
  const wrap = document.getElementById('listWrap');
  const q = document.getElementById('searchBox').value.trim().toLowerCase();
  const isAdmin = role === 'admin';
  let filtered = entries.filter(e=>{
    if(!q) return true;
    const latest = latestCensus(e);
    return (e.name||'').toLowerCase().includes(q) || (latest.remarks||'').toLowerCase().includes(q) || (e.donatedBy||'').toLowerCase().includes(q);
  });
  filtered = filtered.slice().sort((a,b)=> (b.createdAt||0) - (a.createdAt||0));

  if(filtered.length === 0){
    wrap.innerHTML = `<div class="empty-state">
      <div class="glyph">🌱</div>
      <p><strong>No entries yet</strong></p>
      <p>Tap the + button to log your first tree.</p>
    </div>`;
    return;
  }

  wrap.innerHTML = filtered.map(e=>{
    const hist = getHistory(e);
    const latest = hist[0] || { planted:0, surviving:0, month:'', year:'', term:'', remarks:'' };
    const planted = Number(latest.planted)||0;
    const surviving = Number(latest.surviving)||0;
    const pct = planted ? Math.round((surviving/planted)*100) : 0;
    const censusParts = [latest.month, latest.year, latest.term].filter(Boolean);
    const censusLabel = censusParts.length ? censusParts.join(' · ') : 'No census recorded yet';
    const thumb = e.photo
      ? `<img class="thumb" src="${e.photo}" alt="">`
      : `<div class="thumb placeholder">🌳</div>`;

    const historyRows = hist.map(h=>{
      const p = Number(h.planted)||0;
      const s = Number(h.surviving)||0;
      const r = p ? Math.round((s/p)*100) : 0;
      const label = [h.month, h.year, h.term].filter(Boolean).join(' · ') || fmtDate(h.date) || '—';
      const canRemove = isAdmin && hist.length > 1;
      return `<div class="hist-row">
        <span>${escapeHtml(label)}${h.remarks ? ' — ' + escapeHtml(h.remarks) : ''}</span>
        <span><b>${p}</b>/<b>${s}</b> (${r}%)${isAdmin ? ` <button class="hist-edit" data-entry="${e.id}" data-hist="${h.id}">edit</button>` : ''}${canRemove ? ` <button class="hist-remove" data-entry="${e.id}" data-hist="${h.id}">remove</button>` : ''}</span>
      </div>`;
    }).join('') || '<div class="no-history">No census recorded yet.</div>';

    return `<div class="card" data-id="${e.id}">
      <div class="card-main">
        ${thumb}
        <div class="card-body">
          <div class="card-top">
            <div>
              <p class="tree-name">${escapeHtml(e.name || 'Unnamed tree')}</p>
              <div class="tree-meta">Planted ${fmtDate(e.datePlanted)}</div>
              ${e.donatedBy ? `<div class="tree-meta">By ${escapeHtml(e.donatedBy)}</div>` : ''}
            </div>
            <div class="ring-wrap">
              ${ringSVG(pct)}
              <div class="ring-pct">${pct}%</div>
            </div>
          </div>
          <div class="counts">
            <span>Planted <b>${planted}</b></span>
            <span>Surviving <b>${surviving}</b></span>
          </div>
          <div class="census-tag">Latest: ${censusLabel}</div>
        </div>
      </div>
      <details class="census-history">
        <summary>Census history (${hist.length})</summary>
        ${historyRows}
      </details>
      <div class="card-actions">
        <button class="add-census" data-action="census" data-id="${e.id}">${isAdmin ? '+ Census' : 'View census'}</button>
        ${isAdmin ? `<button class="edit-details" data-action="edit" data-id="${e.id}">Edit details</button>` : ''}
        ${isAdmin ? `<button class="del" data-action="delete" data-id="${e.id}">Delete</button>` : ''}
      </div>
    </div>`;
  }).join('');

  wrap.querySelectorAll('[data-action="census"]').forEach(btn=>{
    btn.addEventListener('click', ()=> openCensusSheet(btn.dataset.id));
  });
  wrap.querySelectorAll('[data-action="edit"]').forEach(btn=>{
    btn.addEventListener('click', ()=> openEdit(btn.dataset.id));
  });
  wrap.querySelectorAll('[data-action="delete"]').forEach(btn=>{
    btn.addEventListener('click', ()=> deleteTree(btn.dataset.id));
  });
  wrap.querySelectorAll('.hist-remove').forEach(btn=>{
    btn.addEventListener('click', (ev)=>{
      ev.stopPropagation();
      removeCensusEntry(btn.dataset.entry, btn.dataset.hist);
    });
  });
  wrap.querySelectorAll('.hist-edit').forEach(btn=>{
    btn.addEventListener('click', (ev)=>{
      ev.stopPropagation();
      openCensusSheet(btn.dataset.entry, btn.dataset.hist);
    });
  });
}

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str == null ? '' : str;
  return d.innerHTML;
}


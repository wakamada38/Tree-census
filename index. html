// ---------- Census sheet (view history + add a new one, or edit one in place) ----------
// Pass editHistId to open the sheet pre-filled for editing that specific
// past record instead of adding a new one.
function openCensusSheet(id, editHistId){
  const e = entries.find(x=>x.id === id);
  if(!e) return;
  censusEntryId = id;
  censusEditId = editHistId || null;
  const isAdmin = role === 'admin';
  const hist = getHistory(e);

  document.getElementById('censusSheetTitle').textContent = censusEditId
    ? `Edit Census — ${e.name || 'Unnamed tree'}`
    : `Census — ${e.name || 'Unnamed tree'}`;

  const listEl = document.getElementById('historyPreviewList');
  listEl.innerHTML = hist.length ? hist.map(h=>{
    const p = Number(h.planted)||0;
    const s = Number(h.surviving)||0;
    const r = p ? Math.round((s/p)*100) : 0;
    const label = [h.month, h.year, h.term].filter(Boolean).join(' · ') || '—';
    const canRemove = isAdmin && hist.length > 1;
    return `<div class="hist-row">
      <span>${escapeHtml(label)}${h.remarks ? ' — ' + escapeHtml(h.remarks) : ''}</span>
      <span><b>${p}</b>/<b>${s}</b> (${r}%)${isAdmin ? ` <button class="hist-edit" data-hist="${h.id}">edit</button>` : ''}${canRemove ? ` <button class="hist-remove" data-hist="${h.id}">remove</button>` : ''}</span>
    </div>`;
  }).join('') : '<div class="no-history">No census recorded yet — log the first one below.</div>';

  listEl.querySelectorAll('.hist-edit').forEach(btn=>{
    btn.addEventListener('click', ()=> openCensusSheet(id, btn.dataset.hist));
  });
  listEl.querySelectorAll('.hist-remove').forEach(btn=>{
    btn.addEventListener('click', ()=> removeCensusEntry(id, btn.dataset.hist));
  });

  const formWrap = document.getElementById('censusFormWrap');
  const saveBtn = document.getElementById('censusSaveBtn');
  formWrap.style.display = isAdmin ? 'block' : 'none';
  saveBtn.style.display = isAdmin ? 'block' : 'none';
  saveBtn.textContent = censusEditId ? 'Update This Record' : 'Save New Census';

  if(censusEditId){
    const editing = hist.find(h=>h.id === censusEditId);
    document.getElementById('fPlanted').value = editing ? editing.planted : '';
    document.getElementById('fSurviving').value = editing ? editing.surviving : '';
    document.getElementById('fMonth').value = editing ? editing.month||'' : '';
    document.getElementById('fYear').value = editing ? editing.year||'' : '';
    document.getElementById('fTerm').value = editing ? editing.term||'' : '';
    document.getElementById('fRemarks').value = editing ? editing.remarks||'' : '';
  } else {
    document.getElementById('fPlanted').value = hist.length ? hist[0].planted : '';
    document.getElementById('fSurviving').value = '';
    document.getElementById('fMonth').value = '';
    document.getElementById('fYear').value = '';
    document.getElementById('fTerm').value = '';
    document.getElementById('fRemarks').value = '';
  }

  document.getElementById('censusOverlay').classList.add('open');
}
function closeCensusSheet(){
  document.getElementById('censusOverlay').classList.remove('open');
  censusEntryId = null;
  censusEditId = null;
}
document.getElementById('censusCancelBtn').addEventListener('click', closeCensusSheet);
document.getElementById('censusOverlay').addEventListener('click', (ev)=>{
  if(ev.target.id === 'censusOverlay') closeCensusSheet();
});

document.getElementById('censusSaveBtn').addEventListener('click', async ()=>{
  if(!censusEntryId) return;
  const e = entries.find(x=>x.id === censusEntryId);
  if(!e) return;

  const planted = Number(document.getElementById('fPlanted').value)||0;
  const surviving = Number(document.getElementById('fSurviving').value)||0;
  if(surviving > planted){
    alert("Surviving count can't exceed planted count.");
    return;
  }

  // Preserve any past census data: if this tree still has legacy
  // top-level fields (planted/surviving/censusMonth/...) instead of a
  // censusHistory array, fold them into the array first so nothing is
  // lost.
  const migratedHistory = (Array.isArray(e.censusHistory) && e.censusHistory.length)
    ? e.censusHistory.slice()
    : getHistory(e); // synthesizes legacy into array form if present, else []

  let updatedHistory;
  if(censusEditId){
    // Update the matching record in place — every other record is untouched.
    updatedHistory = migratedHistory.map(h => h.id === censusEditId ? {
      ...h,
      planted,
      surviving,
      month: document.getElementById('fMonth').value,
      year: document.getElementById('fYear').value,
      term: document.getElementById('fTerm').value,
      remarks: document.getElementById('fRemarks').value.trim()
    } : h);
  } else {
    const newEntry = {
      id: 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2,6),
      planted,
      surviving,
      month: document.getElementById('fMonth').value,
      year: document.getElementById('fYear').value,
      term: document.getElementById('fTerm').value,
      remarks: document.getElementById('fRemarks').value.trim(),
      createdAt: Date.now()
    };
    updatedHistory = [...migratedHistory, newEntry];
  }

  const saveBtn = document.getElementById('censusSaveBtn');
  const wasEditing = !!censusEditId;
  saveBtn.disabled = true;
  saveBtn.textContent = 'Saving…';
  try{
    await updateDoc(doc(db, 'tree_census_entries', censusEntryId), {
      censusHistory: updatedHistory,
      // Clear legacy top-level fields now that they live in the array,
      // so this tree's data model is fully migrated going forward.
      planted: deleteField(),
      surviving: deleteField(),
      censusMonth: deleteField(),
      censusYear: deleteField(),
      censusTerm: deleteField(),
      remarks: deleteField(),
      updatedAt: serverTimestamp()
    });
    closeCensusSheet();
  }catch(err){
    console.error('Census save failed', err);
    alert('Could not save the census entry — check your internet connection and try again.');
  }finally{
    saveBtn.disabled = false;
    saveBtn.textContent = wasEditing ? 'Update This Record' : 'Save New Census';
  }
});

async function removeCensusEntry(entryId, histId){
  const e = entries.find(x=>x.id === entryId);
  if(!e) return;
  const hist = getHistory(e);
  if(hist.length <= 1){
    alert('Keep at least one census entry.');
    return;
  }
  if(!confirm('Remove this single census record? Other records are kept.')) return;
  const updatedHistory = hist.filter(h=>h.id !== histId);
  try{
    await updateDoc(doc(db, 'tree_census_entries', entryId), {
      censusHistory: updatedHistory,
      planted: deleteField(),
      surviving: deleteField(),
      censusMonth: deleteField(),
      censusYear: deleteField(),
      censusTerm: deleteField(),
      remarks: deleteField(),
      updatedAt: serverTimestamp()
    });
  }catch(err){
    console.error('Remove failed', err);
    alert('Could not remove that entry — check your internet connection and try again.');
  }
}


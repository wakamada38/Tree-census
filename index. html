document.getElementById('exportBtn').addEventListener('click', ()=>{
  const headers = ['Name of Tree','Donated/Planted By','Date Planted','Census Date','No. Planted','No. Surviving','Survival Rate','Remarks'];
  const rows = [];
  entries.forEach(e=>{
    const hist = getHistory(e);
    if(hist.length === 0){
      rows.push([e.name||'', e.donatedBy||'', e.datePlanted||'', '', '', '', '', '']);
      return;
    }
    hist.slice().sort((a,b)=>(a.createdAt||0)-(b.createdAt||0)).forEach(h=>{
      const p = Number(h.planted)||0;
      const s = Number(h.surviving)||0;
      const pct = p ? Math.round((s/p)*100) : 0;
      const censusLabel = [h.month, h.year, h.term].filter(Boolean).join(' ');
      rows.push([e.name||'', e.donatedBy||'', e.datePlanted||'', censusLabel, p, s, pct+'%', (h.remarks||'').replace(/"/g,'""')]);
    });
  });
  let csv = headers.join(',') + '\n';
  rows.forEach(r=>{
    csv += r.map(v => `"${v}"`).join(',') + '\n';
  });
  const blob = new Blob([csv], {type:'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'sanga-tree-census-' + new Date().toISOString().slice(0,10) + '.csv';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
});

document.getElementById('pdfBtn').addEventListener('click', async ()=>{
  const pdfBtn = document.getElementById('pdfBtn');
  const originalLabel = pdfBtn.textContent;
  pdfBtn.textContent = 'Preparing…';
  pdfBtn.disabled = true;
  try{
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'pt', format: 'a4' });
    const pageWidth = doc.internal.pageSize.getWidth();
    const margin = 40;

    const crestImg = document.querySelector('.crest');
    try{
      if(crestImg && crestImg.src){
        doc.addImage(crestImg.src, 'PNG', margin, 30, 48, 48);
      }
    }catch(e){ /* skip crest if it fails to embed */ }

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(16);
    doc.setTextColor(27, 67, 50);
    doc.text("Sang'a Comprehensive School", margin + 60, 48);
    doc.setFontSize(13);
    doc.text('Trees Census Report', margin + 60, 66);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9);
    doc.setTextColor(90, 90, 90);
    doc.text('Generated ' + new Date().toLocaleDateString('en-GB', {day:'numeric', month:'long', year:'numeric'}), margin + 60, 80);

    let planted = 0, surviving = 0;
    entries.forEach(e=>{
      const latest = latestCensus(e);
      planted += Number(latest.planted)||0;
      surviving += Number(latest.surviving)||0;
    });
    const rate = planted ? Math.round((surviving/planted)*100) : 0;

    doc.setFontSize(10);
    doc.setTextColor(27, 67, 50);
    doc.text(`Total Planted: ${planted}    Total Surviving: ${surviving}    Survival Rate: ${rate}%`, margin, 105);

    const rows = [];
    entries.slice().sort((a,b)=> (b.createdAt||0) - (a.createdAt||0)).forEach(e=>{
      const hist = getHistory(e).slice().sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
      if(hist.length === 0){
        rows.push([e.name||'—', e.donatedBy||'—', fmtDate(e.datePlanted), '0', '0', '0%', '—', '']);
        return;
      }
      hist.forEach(h=>{
        const p = Number(h.planted)||0;
        const s = Number(h.surviving)||0;
        const pct = p ? Math.round((s/p)*100) : 0;
        const censusParts = [h.month, h.year, h.term].filter(Boolean).join(' · ');
        rows.push([
          e.name || '—',
          e.donatedBy || '—',
          fmtDate(e.datePlanted),
          String(p),
          String(s),
          pct + '%',
          censusParts || '—',
          h.remarks || ''
        ]);
      });
    });

    doc.autoTable({
      startY: 118,
      head: [['Tree', 'Donated/Planted By', 'Date Planted', 'Planted', 'Surviving', 'Rate', 'Census', 'Remarks']],
      body: rows,
      styles: { fontSize: 8, cellPadding: 5, overflow: 'linebreak' },
      headStyles: { fillColor: [27, 67, 50], textColor: 255 },
      alternateRowStyles: { fillColor: [244, 240, 227] },
      margin: { left: margin, right: margin },
      columnStyles: {
        0: { cellWidth: 65 },
        1: { cellWidth: 75 },
        2: { cellWidth: 55 },
        3: { cellWidth: 35, halign: 'center' },
        4: { cellWidth: 40, halign: 'center' },
        5: { cellWidth: 30, halign: 'center' },
        6: { cellWidth: 60 },
      }
    });

    const filename = 'sanga-tree-census-' + new Date().toISOString().slice(0,10) + '.pdf';
    const pdfBlob = doc.output('blob');
    const pdfFile = new File([pdfBlob], filename, { type: 'application/pdf' });

    if(navigator.canShare && navigator.canShare({ files: [pdfFile] })){
      await navigator.share({
        files: [pdfFile],
        title: 'Sanga Tree Census Report',
        text: 'Sang\'a Comprehensive School — Trees Census Report'
      });
    } else {
      const url = URL.createObjectURL(pdfBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }
  }catch(err){
    console.error('PDF generation failed', err);
    alert('Could not generate the PDF. Please try again.');
  }finally{
    pdfBtn.textContent = originalLabel;
    pdfBtn.disabled = false;
  }
});

startSync();
renderAll();
updateRoleUI();
if(!role){
  openGate();
} else {
  const crestSrc = document.querySelector('.crest')?.src || '';
  document.getElementById('gateCrest').src = crestSrc;
}

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js').catch((err) => {
      console.warn('Service worker registration failed', err);
    });
  });
}
</script>
</body>
</html>

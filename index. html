// ---------- Census history helpers ----------
// Normalizes an entry's census data into an array, synthesizing one
// from legacy top-level fields (planted/surviving/censusMonth/...) if
// no censusHistory array exists yet. This is read-only in memory —
// the actual migration into Firestore happens the first time a new
// census is saved for that tree (see saveCensus()).
function getHistory(e){
  if(Array.isArray(e.censusHistory) && e.censusHistory.length){
    return e.censusHistory.slice().sort((a,b)=> (b.createdAt||0) - (a.createdAt||0));
  }
  if(e.planted !== undefined && e.planted !== null && e.planted !== ''){
    return [{
      id: 'legacy',
      planted: e.planted,
      surviving: e.surviving,
      month: e.censusMonth || '',
      year: e.censusYear || '',
      term: e.censusTerm || '',
      remarks: e.remarks || '',
      createdAt: e.createdAt || 0
    }];
  }
  return [];
}
function latestCensus(e){
  const hist = getHistory(e);
  return hist.length ? hist[0] : { planted: 0, surviving: 0, month:'', year:'', term:'', remarks:'' };
}

